server {
  listen 8080;
  server_name _;
  root /usr/share/nginx/html;
  index index.html;

  # Re-resolve the backend name when it changes, such as after a container restart or a new pod IP.
  resolver ${NGINX_LOCAL_RESOLVERS} valid=10s;
  set $backend_url http://${BACKEND_HOST}:8000;

  location / {
    try_files $uri /index.html;
  }

  # Local Docker Compose and Kubernetes service-to-service API proxy.
  location /api/ {
    proxy_pass $backend_url;
    proxy_http_version 1.1;
    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
  }

  location /health {
    proxy_pass $backend_url/health;
  }
}
